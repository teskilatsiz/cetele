{
  "expo": {
    "name": "Çetele",
    "slug": "cetele",
    "version": "1.0.0",
    "description": "Nostr üzerinde gizlilik odaklı not alma. Şifreli, sansüre dayanıklı ve merkeziyetsiz.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cetele",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "owner": "teskilatsiz",
    "ios": {
      "supportsTablet": false,
      "usesIcloudStorage": true,
      "backgroundColor": "#000000",
      "icon": "./assets/images/icon.png",
      "appStoreUrl": "https://apps.apple.com/tr/app/%C3%A7etele-%C5%9Fifreli-notlar/id6780082788",
      "bundleIdentifier": "com.teskilatsiz.cetele",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "tr",
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "tr",
          "en",
          "ru",
          "hi",
          "pt"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.teskilatsiz.cetele",
      "icon": "./assets/images/icon.png",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.teskilatsiz.cetele",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/cetele.png",
        "monochromeImage": "./assets/images/icon-monochrome.png",
        "backgroundColor": "#000000"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "themeColor": "#000000",
      "lang": "tr",
      "description": "Nostr üzerinde gizlilik odaklı not alma. Şifreli, sansüre dayanıklı ve merkeziyetsiz."
    },
    "locales": {
      "tr": "./src/locales/tr.json",
      "en": "./src/locales/en.json",
      "ru": "./src/locales/ru.json",
      "hi": "./src/locales/hi.json",
      "pt": "./src/locales/pt.json"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-system-ui",
      "./plugins/withBottomNavStyle.js",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Çetele, notlarınıza fotoğraf ve video eklemek için medya arşivinize erişir.",
          "cameraPermission": false,
          "microphonePermission": false,
          "dark": {
            "colors": {
              "cropToolbarColor": "#000000",
              "cropToolbarIconColor": "#ffffff",
              "cropToolbarActionTextColor": "#0A84FF",
              "cropBackButtonIconColor": "#ffffff",
              "cropBackgroundColor": "#000000"
            }
          },
          "light": {
            "colors": {
              "cropToolbarColor": "#ffffff",
              "cropToolbarIconColor": "#000000",
              "cropToolbarActionTextColor": "#0A84FF",
              "cropBackButtonIconColor": "#000000",
              "cropBackgroundColor": "#ffffff"
            }
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Çetele, şifreli notlarınıza güvenli erişim sağlamak ve gizli anahtarınızı yetkisiz erişimlerden korumak için Face ID doğrulaması kullanır."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      "expo-video",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "lintOptions": {
              "checkReleaseBuilds": false,
              "abortOnError": false
            }
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "tr",
              "en",
              "ru",
              "hi",
              "pt"
            ],
            "android": [
              "tr",
              "en",
              "ru",
              "hi",
              "pt"
            ]
          }
        }
      ],
      "./plugins/withDefaultAndroidResources.js",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07a8ae86-06b0-4a28-9190-65abdadb0ec6"
      }
    }
  }
}